# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=graphgpt-embedding-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=all-MiniLM-L6-v2
MODEL_PATH=/path/to/models/all-MiniLM-L6-v2
DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# ── Inference ────────────────────────────────────────────────────────────────
BATCH_SIZE=64
MAX_BATCH_SIZE=256
MAX_TEXT_LENGTH=8192

# ── REST Server ──────────────────────────────────────────────────────────────
REST_PORT=8005
REST_HOST=0.0.0.0

# ── gRPC Server ──────────────────────────────────────────────────────────────
GRPC_PORT=50054
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=10
GRPC_MAX_MESSAGE_LENGTH=4194304
