# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=graphgpt-embedding-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ---- Embedding model ------------------------------------------------------------------------------------------------------------------
# Changing the embedding model makes every stored vector incompatible: build a NEW index generation with the new model in retrieval-service
# (see its docs/configuration.md) instead of switching this on a live system.
MODEL_NAME=all-MiniLM-L6-v2
# Optional local copy of the model. Used only if its last folder name equals MODEL_NAME's last part; otherwise ignored with a warning.
MODEL_PATH=
DEVICE=cpu
NORMALIZE_EMBEDDINGS=true
TOKENIZER_ID=
MAX_SEQ_LENGTH=0
# Instruction prefixes some models need. QUERY_PREFIX applies to GenerateEmbedding (one text), PASSAGE_PREFIX to GenerateEmbeddings (batches).
#   multilingual-e5-*:   QUERY_PREFIX="query: "  PASSAGE_PREFIX="passage: "
QUERY_PREFIX=
PASSAGE_PREFIX=

# ── Inference ────────────────────────────────────────────────────────────────
BATCH_SIZE=64
MAX_BATCH_SIZE=256
MAX_TEXT_LENGTH=8192

# ── REST Server ──────────────────────────────────────────────────────────────
REST_PORT=8005
REST_HOST=0.0.0.0

# ── gRPC Server ──────────────────────────────────────────────────────────────
GRPC_PORT=50054
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=10
GRPC_MAX_MESSAGE_LENGTH=4194304

# ---- Reranker ---------------------------------------------------------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Extra rerankers a caller may select per request (comma-separated). Anything not listed here (or RERANKER_MODEL) is refused.
RERANKER_ALLOWED_MODELS=
# Rerankers kept in memory at once; selecting another evicts the least recently used.
RERANKER_MAX_LOADED=1
RERANKER_PRELOAD=false
RERANKER_MAX_PASSAGES=50
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16

# ---- Load handling ---------------------------------------------------------------------------------------------------------------------
PRIORITY_LANES_ENABLED=false
BULK_SLICE_SIZE=16
BULK_MAX_PENDING=4
QUERY_CACHE_SIZE=0
QUERY_CACHE_REDIS_URL=
QUERY_CACHE_REDIS_TTL_SECONDS=3600
TRUNCATION_METRIC_ENABLED=true
